{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "deliveries",
    "runs",
    "observations"
  ],
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "p5-v1"
      ]
    },
    "deliveries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "event",
          "channel",
          "recipient",
          "state",
          "attempts",
          "updatedAt",
          "errorCode",
          "receiptHash",
          "history"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "event": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "purpose",
              "sourceRun",
              "subject",
              "version",
              "title",
              "message",
              "url",
              "evidence"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "type": {
                "type": "string",
                "enum": [
                  "related-notice",
                  "project-update",
                  "deadline",
                  "run-problem",
                  "review-required"
                ]
              },
              "purpose": {
                "type": "string",
                "enum": [
                  "formal",
                  "diagnostic"
                ]
              },
              "sourceRun": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "subject": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 6000
              },
              "url": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "locator",
                    "quote"
                  ],
                  "properties": {
                    "locator": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  }
                },
                "minItems": 0,
                "maxItems": 30
              }
            }
          },
          "channel": {
            "type": "string",
            "enum": [
              "local-preview"
            ]
          },
          "recipient": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "writing",
              "previewed",
              "failed",
              "unknown"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "updatedAt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "errorCode": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "receiptHash": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ]
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "at",
                "attempt",
                "errorCode"
              ],
              "properties": {
                "state": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "writing",
                    "previewed",
                    "failed",
                    "unknown"
                  ]
                },
                "at": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 50
                },
                "attempt": {
                  "type": "integer",
                  "minimum": 0
                },
                "errorCode": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "minItems": 1,
            "maxItems": 1000
          }
        }
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "purpose",
          "sourceRun",
          "startedAt",
          "referenceTime",
          "finishedAt",
          "status",
          "deliveryIds",
          "added",
          "reused",
          "errorCode",
          "history"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "purpose": {
            "type": "string",
            "enum": [
              "formal",
              "diagnostic"
            ]
          },
          "sourceRun": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "startedAt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "referenceTime": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "finishedAt": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "complete",
              "partial",
              "failed",
              "cancelled"
            ]
          },
          "deliveryIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "minItems": 0,
            "maxItems": 100000
          },
          "added": {
            "type": "integer",
            "minimum": 0
          },
          "reused": {
            "type": "integer",
            "minimum": 0
          },
          "errorCode": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "at",
                "errorCode"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "running",
                    "complete",
                    "partial",
                    "failed",
                    "cancelled"
                  ]
                },
                "at": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 50
                },
                "errorCode": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "minItems": 1,
            "maxItems": 1000
          }
        }
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "purpose",
          "subject",
          "version",
          "contentHash",
          "fetchedAt",
          "relevant"
        ],
        "properties": {
          "purpose": {
            "type": "string",
            "enum": [
              "formal",
              "diagnostic"
            ]
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "contentHash": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "fetchedAt": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ]
          },
          "relevant": {
            "type": "string",
            "enum": [
              "yes",
              "no"
            ]
          }
        }
      },
      "minItems": 0,
      "maxItems": 100000
    }
  }
}
