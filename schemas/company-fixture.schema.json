{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "facts"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "synthetic"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "validUntil"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "validUntil": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 10
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "minItems": 0,
      "maxItems": 100
    }
  }
}
