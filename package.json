{
  "name": "tender-assistant",
  "version": "0.0.0",
  "private": true,
  "description": "政府招投标信息助手；P1 两站公开采集验证",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/test/unit/*.test.js",
    "collect:p1": "pnpm run build && node dist/src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.1",
  "devDependencies": {
    "@types/node": "24.13.6",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  }
}
